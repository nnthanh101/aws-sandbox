{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "description": "aws-sandbox (sandbox-for-aws) - ADLC Autonomous Mode (CDK development, deny git mutations)",
  "version": "3.0.0",
  "project": "sandbox-for-aws",

  "permissions": {
    "allow": [
      "Read(*)",
      "Glob(*)",
      "Grep(*)",
      "Write(*)",
      "Edit(*)",
      "WebSearch",
      "WebFetch(*)",

      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(cdk synth:*)",
      "Bash(cdk diff:*)",
      "Bash(cdk list:*)",
      "Bash(cdk doctor:*)",
      "Bash(vitest:*)",
      "Bash(node:*)",
      "Bash(task:*)",
      "Bash(docker:*)",

      "Bash(aws sts:*)",
      "Bash(aws cloudformation describe:*)",
      "Bash(aws cloudformation list:*)",
      "Bash(aws s3 ls:*)",
      "Bash(aws iam list:*)",
      "Bash(aws iam get:*)",
      "Bash(aws ec2 describe:*)",

      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(gh repo:*)",
      "Bash(gh issue:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh api:*)",

      "Bash(ls:*)",
      "Bash(tree:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(mkdir:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(jq:*)",
      "Bash(yq:*)",
      "Bash(echo:*)",
      "Bash(tee:*)",
      "Bash(du:*)",
      "Bash(touch:*)",
      "Bash(chmod:*)",
      "Bash(bash:*)",
      "Bash(curl:*)",
      "Bash(xargs:*)",
      "Bash(test:*)",
      "Bash(export:*)",
      "Bash(nvm:*)"
    ],
    "ask": [],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",

      "Bash(rm -rf:*)",
      "Bash(rm -r:*)",
      "Bash(sudo:*)",
      "Bash(dd:*)",
      "Bash(mkfs:*)",

      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git revert:*)",
      "Bash(git checkout:*)",
      "Bash(git stash:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git tag:*)",
      "Bash(git branch -d:*)",
      "Bash(git branch -D:*)",
      "Bash(gh pr create:*)",
      "Bash(npm publish:*)",

      "Bash(cdk deploy:*)",
      "Bash(cdk destroy:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",

      "Bash(aws iam delete:*)",
      "Bash(aws iam create-access-key:*)",
      "Bash(aws iam put:*)",
      "Bash(aws iam attach:*)",
      "Bash(aws iam create-user:*)",
      "Bash(aws organizations close:*)",
      "Bash(aws s3 rb:*)",
      "Bash(aws s3 rm:*)",
      "Bash(aws ec2 terminate:*)",
      "Bash(aws ec2 delete:*)"
    ]
  },

  "env": {
    "ADLC_PROJECT": "sandbox-for-aws",
    "ADLC_VERSION": "3.0.0",
    "ADLC_PASS_RATE_THRESHOLD": "99.5",
    "ADLC_MANDATORY_AGENTS": "product-owner,cloud-architect",
    "ADLC_ENFORCEMENT_MODE": "BLOCKING",
    "ADLC_AUTONOMOUS_MODE": "true",
    "ADLC_PERMISSION_MODE": "acceptEdits",
    "AWS_REGION": "ap-southeast-2"
  }
}
